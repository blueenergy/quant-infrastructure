# Copy to secret.env (do not commit), fill values, then:
# kubectl create secret generic quant-secrets -n aipoc --from-env-file=secret.env --dry-run=client -o yaml | kubectl apply -f -

MONGO_URI=mongodb://user:pass@mongodb-host:27017/?authSource=admin&maxPoolSize=20
MONGO_URL=mongodb://user:pass@mongodb-host:27017/?authSource=admin&maxPoolSize=20
MONGO_DB=finance
JWT_SECRET_KEY=change-me
TUSHARE_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
QWEN_API_KEY=
BACKTEST_API_TOKEN=
SECONDARY_MONGO_URI=
SECONDARY_MONGO_DB=

# quant-data-engine API triggers (use host reachable from K8s, not quant-api DNS)
INTRADAY_T0_TRIGGER_URL=http://<API_HOST>:3001/api/intraday-t0/signals/generate-all
INTRADAY_T0_TRIGGER_KEY=
MARKET_INSIGHT_TRIGGER_URL=http://<API_HOST>:3001/api/market-insights/generate-internal
MARKET_INSIGHT_TRIGGER_KEY=

# Portfolio research artifacts (external_k8s upload + API read from bucket aipoc)
PORTFOLIO_RESEARCH_S3_ENDPOINT=https://es-si-s3-z4.eecloud.nsn-net.net
PORTFOLIO_RESEARCH_S3_BUCKET=aipoc
PORTFOLIO_RESEARCH_S3_ACCESS_KEY=
PORTFOLIO_RESEARCH_S3_SECRET_KEY=
PORTFOLIO_RESEARCH_S3_REGION=us-east-1
