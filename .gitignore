# Logs
*.log
host/mirror_to_acr.log.*

# Runtime data/logs/strategy state (bind-mounted from containers; do not commit)
apps/data/
apps/logs/
apps/state/

# Environment
.env
# Per-service runtime env files (secrets). Examples (*.env.example) stay tracked,
# and apps/versions.env (image tags) is intentionally NOT ignored.
apps/env/*.env
host/.env.monitor

# Hermes runtime data store (created & owned by the hermes container).
infra/hermes-data/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Backup files
*.bak
backup/
*.tar.gz
*.zip

# Temporary files
tmp/
temp/
__pycache__/
*.pyc

# MongoDB replica set keyFile (generated on primary, copied to secondary)
infra/mongodb/keyfile
