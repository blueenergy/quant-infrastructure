# ============================================================================
# quant-model-trainer.env — ML training worker (quant_ml). NOT committed.
# ----------------------------------------------------------------------------
# Loaded after common.env. Requires MONGO_URI with read/write on database
# QUANT_ML_DB (default quant_ml). Do not point at a read-only production user
# if the worker must create indexes on first start.
#
# Runtime gate (also in common.env):
#   MODEL_TRAINING_RUNTIME=local_docker   — compose profile model-trainer-local
#   MODEL_TRAINING_RUNTIME=external_k8s — use K8s Deployment only
# ============================================================================

QUANT_ML_DB=quant_ml
# Parquet cache inside the container; compose binds ./data/quant_ml → /data/quant_ml
QUANT_ML_PARQUET_ROOT=/data/quant_ml/parquet

# Optional object store for future snapshot jobs (training MVP may ignore)
# QUANT_ML_S3_BUCKET=
# QUANT_ML_S3_PREFIX=quant_ml

MODEL_TRAINING_LOOP_INTERVAL_SECONDS=5
MODEL_TRAINING_LOOP_LIMIT=1
MODEL_TRAINING_STALE_MINUTES=120
MODEL_TRAINING_WORKER_ID=quant-model-trainer

# Isolate queues when multiple dev machines share one Mongo (optional)
# MODEL_TRAINING_WORKER_POOL=local-docker
