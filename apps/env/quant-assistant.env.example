# ============================================================================
# quant-assistant.env — Service-specific config. NOT committed.
# ----------------------------------------------------------------------------
# Loaded after common.env; MONGO_URI / MONGO_DB come from common.env.
# The assistant reads production data read-only and writes only assistant_*.
# ============================================================================

ASSISTANT_FINANCE_DB=finance
ASSISTANT_DATA_DB=quant_data
ASSISTANT_ANALYZER_DB=quant_analyzer
ASSISTANT_TRADING_DB=quant_trading

# Account-number scopes (preferred over the legacy username scopes):
# one user may own several securities accounts.
ASSISTANT_PORTFOLIO_ACCOUNTS=
ASSISTANT_AUCTION_SCOPE_ACCOUNTS=
ASSISTANT_PORTFOLIO_USERNAMES=shuyolin
ASSISTANT_AUCTION_SCOPE_USERNAMES=
ASSISTANT_WATCHLIST_USERNAMES=shuyolin,blue_energy
ASSISTANT_LLM_USERNAME=shuyolin

ASSISTANT_NARRATIVE_MODEL=MiniMax-M3.1-Flash
ASSISTANT_FALLBACK_MODEL=MiniMax-M2.7
ASSISTANT_STRUCTURED_MODEL=MiniMax-M2.7
# MiniMax-M3.x requires adaptive thinking; low keeps routine briefs cheap.
ASSISTANT_REASONING_EFFORT=low
ASSISTANT_MAX_LLM_TOKENS=4000
ASSISTANT_OUTPUT_DIR=/out
ASSISTANT_DRY_RUN=0
