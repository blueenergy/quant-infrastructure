# ============================================================================
# common.env — Runtime config SHARED by all app services. NOT committed.
# ----------------------------------------------------------------------------
# Copy to common.env on the production host and fill in REAL values there.
# This *.example file is a placeholder template only — real secrets live in
# common.env on the host (gitignored), never committed.
# Loaded first; per-service env/<svc>.env is loaded after and overrides these.
#
# The production database lives on a SEPARATE machine, so MONGO_URI points to
# that remote host (NOT localhost / NOT the `mongodb` service name). It is the
# same remote address for every service, hence shared here.
# ============================================================================

# Remote production DB (fill host/credentials on the prod machine).
MONGO_URI=mongodb://<user>:<password>@<DB_HOST>:27017/?authSource=admin&maxPoolSize=20
MONGO_DB=finance
REALTIME_DB_NAME=quant_realtime

# Timezone
TZ=Asia/Shanghai

# ----------------------------------------------------------------------------
# Portfolio research runtime (Compose host vs external Kubernetes)
# ----------------------------------------------------------------------------
# local_docker  — deploy.sh enables Compose profile research-local (default)
# external_k8s  — skip local quant-researcher; run workers from k8s/
PORTFOLIO_RESEARCH_RUNTIME=local_docker
# local_docker  — deploy.sh enables Compose profile scorer-local (default)
# external_k8s  — skip local quant-scorer; run the scheduler from k8s/
QUANT_SCORER_RUNTIME=local_docker
# Optional explicit Compose profiles. If unset, deploy.sh derives from
# both runtime settings.
# COMPOSE_PROFILES=research-local,scorer-local

# ----------------------------------------------------------------------------
# Portfolio research S3 (external_k8s artifacts — bucket aipoc)
# ----------------------------------------------------------------------------
# Required on K8s quant-researcher (upload) and Compose quant-api (read).
# Create bucket once (FCI): s3cmd -c deployment/credentials/s3cfg mb s3://aipoc
# PORTFOLIO_RESEARCH_S3_ENDPOINT=https://es-si-s3-z4.eecloud.nsn-net.net
# PORTFOLIO_RESEARCH_S3_BUCKET=aipoc
# PORTFOLIO_RESEARCH_S3_ACCESS_KEY=
# PORTFOLIO_RESEARCH_S3_SECRET_KEY=
# PORTFOLIO_RESEARCH_S3_REGION=us-east-1
# Optional override: PORTFOLIO_RESEARCH_ARTIFACT_BACKEND=local|s3

# ---- Resource limits for stock-scoring-system containers ----
# Override these to match the host's CPU/RAM capacity.
# Defaults in docker-compose.yml assume a 4-core host.
# Docker requires cpus <= host core count; memory accepts k/m/g suffixes.
# SCORER_CPU_LIMIT=4
# SCORER_MEM_LIMIT=4g
# RESEARCHER_CPU_LIMIT=2
# RESEARCHER_MEM_LIMIT=6g
# PORTFOLIO_CPU_LIMIT=1
# PORTFOLIO_MEM_LIMIT=512m
