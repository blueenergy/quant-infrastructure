# ============================================================================
# quant-scorer.env — Service-specific config & secrets. NOT committed.
# ----------------------------------------------------------------------------
# Loaded after common.env. Shared keys (MONGO_URI / MONGO_DB / TZ) are in
# common.env. The scorer uses host.docker.internal to reach quant-api on the
# same host for internal trigger calls.
# ============================================================================

DATA_DB_NAME=quant_data
# Required by quant-portfolio as well as quant-scorer: plan generation uses
# Tushare trade_cal to resolve future trading days such as execute_date.
TUSHARE_TOKEN=your_tushare_token

# Keep true in production so quant-portfolio fails fast if TUSHARE_TOKEN is
# accidentally removed. Set false only for local/offline tests that rely purely
# on already-loaded volume_price dates.
PORTFOLIO_REQUIRE_TUSHARE_TOKEN=true

# ----------------------------------------------------------------------------
# Portfolio research worker recovery (tools/process_portfolio_research_jobs.py)
# ----------------------------------------------------------------------------
# Research jobs are claimed by a long-running loop, not by the legacy 5-minute
# cron. Lower this for faster pickup; raise it to reduce idle DB polling writes.
PORTFOLIO_RESEARCH_LOOP_INTERVAL_SECONDS=5
# Maximum completed/failed jobs to drain before the loop sleeps again.
PORTFOLIO_RESEARCH_LOOP_LIMIT=2
# How often the loop checks for orphaned running jobs to requeue.
PORTFOLIO_RESEARCH_STALE_CHECK_INTERVAL_SECONDS=60
# A running research job whose heartbeat is older than this many minutes is
# requeued back to pending on the next worker run. A background ticker keeps
# heartbeat_at fresh during long stages, so this can stay small; it is only a
# backstop for SIGKILL/OOM where graceful SIGTERM release did not run.
PORTFOLIO_RESEARCH_STALE_MINUTES=5
# Background heartbeat interval (seconds) while a job runs. Keep well below
# PORTFOLIO_RESEARCH_STALE_MINUTES so a live worker never looks stale.
PORTFOLIO_RESEARCH_HEARTBEAT_SECONDS=30
# Concurrency for the research dataset price preload. Each symbol is an
# independent remote read; concurrent fetches cut build_dataset time. Keep at
# or below MONGO_MAX_POOL_SIZE. Set to 1 to fall back to sequential loading.
PORTFOLIO_RESEARCH_PRELOAD_WORKERS=8
# Parallel outer sweep jobs inside one research task (fork). Dev: stock-scoring-system/.env;
# production: set here or in the host env injected into quant-researcher.
# PORTFOLIO_RESEARCH_SWEEP_WORKERS=2
# K8s quant-researcher manifest defaults to 6 (10Gi limit per pod).
# When running multiple K8s researcher replicas, prefer moderate SWEEP_WORKERS and
# scale replicas instead (avoids double memory pressure / OOM).
#
# Unique worker id (optional). On Kubernetes set from the Pod name so status
# rows and claim ownership are distinct per replica.
# PORTFOLIO_RESEARCH_WORKER_ID=

# ----------------------------------------------------------------------------
# Portfolio Research Cache Contract v2
# ----------------------------------------------------------------------------
# The checked-in Compose/K8s manifests pin these safe initial values. Shadow
# reads only compare potential hits with a fresh computation; they never serve
# cached results. Shadow writes never publish readable manifests.
PORTFOLIO_RESEARCH_CACHE_V2_READ_MODE=shadow
PORTFOLIO_RESEARCH_CACHE_V2_WRITE_MODE=shadow
# Docker Compose uses filesystem; Kubernetes overrides this to s3.
PORTFOLIO_RESEARCH_CACHE_V2_BACKEND=filesystem
PORTFOLIO_RESEARCH_CACHE_V2_DIR=/var/cache/portfolio-research/v2
# Docker local cache recommendation; K8s researcher overrides this to 20 GiB.
PORTFOLIO_RESEARCH_CACHE_V2_L1_MAX_BYTES=53687091200
PORTFOLIO_RESEARCH_CACHE_V2_L1_EVICT_RATIO=0.85
# Injected from QUANT_SCORER_IMAGE_TAG by Compose/deploy tooling; never use latest.
# PORTFOLIO_RESEARCH_CACHE_V2_PRODUCER_REVISION=
PORTFOLIO_RESEARCH_CACHE_V2_S3_PREFIX=portfolio-research/cache/v2
PORTFOLIO_RESEARCH_CACHE_V2_LEASE_TTL_SECONDS=180
PORTFOLIO_RESEARCH_CACHE_V2_LEASE_RENEW_SECONDS=30
PORTFOLIO_RESEARCH_CACHE_V2_BUILDER_WAIT_SECONDS=1200
PORTFOLIO_RESEARCH_CACHE_V2_BUILDER_POLL_SECONDS=5
PORTFOLIO_RESEARCH_CACHE_V2_LEDGER_DB=finance
PORTFOLIO_RESEARCH_CACHE_V2_LEDGER_COLLECTION=portfolio_cache_source_revisions_v2
PORTFOLIO_RESEARCH_CACHE_V2_LEASE_COLLECTION=portfolio_cache_leases_v2
# quant-scorer writes finance.stock_scores and must fail closed around each
# source mutation. Compose/K8s explicitly override researcher back to off.
PORTFOLIO_RESEARCH_SOURCE_LEDGER_MODE=on
PORTFOLIO_RESEARCH_SOURCE_LEDGER_TTL_SECONDS=900
PORTFOLIO_RESEARCH_SOURCE_LEDGER_HEARTBEAT_SECONDS=60

# Weekday 21:30 audit scheduler settings. The cron/script are mounted by infra;
# initialization remains a manual runbook step.
PORTFOLIO_RESEARCH_COVERAGE_AUDIT_STABILITY_SECONDS=60
PORTFOLIO_RESEARCH_COVERAGE_AUDIT_TTL_HOURS=24
PORTFOLIO_RESEARCH_COVERAGE_AUDIT_BY=quant-scorer-cron
