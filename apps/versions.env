# ============================================================================
# versions.env — Desired image tags for the application stack (the "values.yaml")
# ----------------------------------------------------------------------------
# This file IS committed to git and is the single source of truth for which
# image version runs in production. App repos' CI bump the relevant line after
# pushing a new image; the infra CD workflow then rolls it out.
#
# RULES:
#   - Only put `*_IMAGE_TAG` values here. NO secrets (those live in .env).
#   - Prefer immutable tags (sha-xxxxxxx) over `latest` so deploys are
#     reproducible and rollback == git revert of this file.
#
# Used for docker-compose interpolation (see deploy.sh):
#   docker compose --env-file versions.env ...
# Only this file feeds compose ${...} interpolation. Per-service runtime
# config/secrets are injected via env_file: (env/<svc>.env) in the compose
# file, NOT through interpolation, so do not rely on a top-level .env here.
# ============================================================================

# quant-api image powers: quant-api, quant-mcp, quant-mcp-actions, quant-scheduler
QUANT_API_IMAGE_TAG=sha-3e944cd

# quant-dashboard image powers: quant-web
QUANT_DASHBOARD_IMAGE_TAG=sha-65c4af3

QUANT_SCORER_IMAGE_TAG=sha-4c8111a
# Staged cutover: the compose service still points at quant-scorer until the
# quant-portfolio image is published and verified.
QUANT_PORTFOLIO_IMAGE_TAG=sha-fe95040
# Staged cutover for quant-factor-researcher; compose still points at quant-scorer.
QUANT_FACTOR_RESEARCH_IMAGE_TAG=sha-88cdfa1
QUANT_MODEL_TRAINER_IMAGE_TAG=sha-24f86dd
# Portfolio research worker (quant-portfolio-research); service quant-portfolio-researcher.
QUANT_PORTFOLIO_RESEARCH_IMAGE_TAG=sha-ef08c27
QUANT_DATA_ENGINE_IMAGE_TAG=sha-171e748
BACKTEST_WORKER_IMAGE_TAG=sha-eece86c
QUANT_ANALYZER_IMAGE_TAG=sha-7ddb08a
# Number of quant-analyzer worker replicas. deploy.sh reads this and applies
# --scale quant-analyzer=N automatically. Change here to scale up/down.
QUANT_ANALYZER_REPLICAS=3

QUANT_STRATEGY_MANAGER_IMAGE_TAG=sha-0c44b5f

# quant-trader powers the live order-entry container (profile trader-local, so
# nothing starts it by default). The simulator image (quant-trader-sim) is
# dev/test only and is deliberately not pinned here.
QUANT_TRADER_IMAGE_TAG=sha-5c82e8d

# quant-assistant is a scheduled host cron one-shot (host/assistant_brief.sh),
# not a long-running compose service. CI replaces this placeholder with the
# first real sha-* tag; the host cron reads it on each run.
QUANT_ASSISTANT_IMAGE_TAG=sha-ac392c0
