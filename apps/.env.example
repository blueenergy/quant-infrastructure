# ============================================================================
# DEV ONLY — shared Compose interpolation (docker-compose.dev.yml)
# ============================================================================
#   cp .env.example .env
#   ./compose-dev.sh up ...
#
# Keep this file small: only secrets/URLs used by many services via ${VAR} in
# compose. Service-specific settings belong in that repo's .env (env_file).
#
# Production: env/common.env + env/<service>.env + deploy.sh (not this file).
# ============================================================================

# Mongo (containers on quant-network use quant-mongodb)
DOCKER_MONGO_URI=mongodb://admin:changeme@quant-mongodb:27017/?authSource=admin&maxPoolSize=20
MONGO_DB=finance
DATA_DB_NAME=quant_data
ANALYZER_DB_NAME=quant_analyzer
REALTIME_DB_NAME=quant_realtime

# Shared secrets (quant-api, MCP, scheduler, scoring roles, …)
JWT_SECRET_KEY=your_dev_jwt_secret
TUSHARE_TOKEN=your_tushare_token
HERMES_QUANT_INTERNAL_KEY=

# Optional shared tuning (compose has defaults if omitted)
API_WORKERS=2

# ----------------------------------------------------------------------------
# Portfolio research runtime (local Docker vs external K8s)
# ----------------------------------------------------------------------------
# local_docker   — start quant-researcher via Compose profile research-local
# external_k8s   — do NOT start local researcher; workers run in Kubernetes
PORTFOLIO_RESEARCH_RUNTIME=local_docker
# local_docker   — start daily scorer via Compose profile scorer-local
# external_k8s   — do NOT start local scorer; scheduler runs in Kubernetes
QUANT_SCORER_RUNTIME=local_docker
# Keep only the profiles whose roles run locally.
COMPOSE_PROFILES=research-local,scorer-local
# K8s repository for researcher/scorer; deploy helpers read the immutable tag
# from versions.env (QUANT_SCORER_IMAGE_TAG).
QUANT_SCORER_IMAGE_REPOSITORY=crpi-gv3f6mfcrw75qane.cn-hangzhou.personal.cr.aliyuncs.com/wukongquant/quant-scorer

# --- Not here (use repo .env + env_file in docker-compose.dev.yml) ---
# quantAnalyzer/.env          QWEN_*, DISABLE_AUTO_ANALYSIS, LIMIT_UP_*, …
# stock-scoring-system/.env   PORTFOLIO_RESEARCH_SWEEP_WORKERS, RESEARCHER_*_LIMIT, …
# quantFinance/.env.template  SMTP_*, PUBLIC_HOST, BACKTEST_WORKER_TOKEN, …
# quantTrader/.env            TRADER_* overrides
# backtest-worker/.env        ENABLE_SCREENING, SCREENING_*, …
